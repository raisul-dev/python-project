#Basic Student Management System used oop concepts
class Student:
  def __init__(self,name,id,dep,CGPA):
    self.name = name 
    self.id = id 
    self.dep = dep
    self.CGPA = CGPA
#create display info mathods
  def display_info(self):
    print(f"Name:{self.name}\nID:{self.id}\nDeparment:{self.dep}\nCGPA:{self.CGPA}")
#we use update_cgpa  and can change cgpa
  def update_cgpa(self,up_cgpa):
    self.CGPA = up_cgpa
    print(f'update cgpa :{self.CGPA}')
#we chack student passed or not 
  def is_passed (self):
    if self.CGPA > 2.00 :
      print("passed")
    else :
      print("FALL")
#call class and set name,id,depm,cgpa
ob1 = Student('remon',20,'cse',3.50)
ob1.display_info()
ob1.update_cgpa(4.00)
ob1.is_passed()
